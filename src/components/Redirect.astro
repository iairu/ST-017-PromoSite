---
// Landing page that sends the visitor to /en/ or /sk/. Used at the site root and for the old,
// un-prefixed URLs (/parts/ and so on), so links that were shared before the split keep working.
//
// Which language: the choice made with the header switcher (localStorage 'lelek-lang') wins;
// for a new browser the first language the browser asks for decides: Czech or Slovak go to /sk/,
// everything else to /en/. Without JavaScript the two links below are shown (and a <noscript>
// refresh takes search engines and old browsers to the English page).
import { url } from '../data/site.js';
import { content, langs, defaultLang } from '../i18n/index.js';
const { path = '/', index = true } = Astro.props;
const targets = Object.fromEntries(langs.map((l) => [l, url(`/${l}${path}`)]));
const abs = (p) => (Astro.site ? new URL(p, Astro.site).href : p);
const en = content('en');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>NightJar.Gift</title>
    <meta name="description" content={en.site.description} />
    <meta name="theme-color" content="#181b29" />
    {!index && <meta name="robots" content="noindex" />}
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    {langs.map((l) => <link rel="alternate" hreflang={l} href={abs(targets[l])} />)}
    <link rel="alternate" hreflang="x-default" href={abs(targets[defaultLang])} />
    <noscript><meta http-equiv="refresh" content={`0;url=${targets[defaultLang]}`} /></noscript>
    <script is:inline define:vars={{ targets }}>
      (function () {
        var l = null;
        try { l = localStorage.getItem('lelek-lang'); } catch (e) {}
        if (l !== 'sk' && l !== 'en') {
          var nl = (navigator.languages && navigator.languages[0]) || navigator.language || '';
          var p = String(nl).toLowerCase().split('-')[0];
          l = p === 'sk' || p === 'cs' ? 'sk' : 'en';
        }
        location.replace(targets[l] + location.search + location.hash);
      })();
    </script>
    <style>
      html { background: #0d0f18; color: #f1e8d4; font: 400 1.1rem/1.6 Georgia, 'Times New Roman', serif; }
      body { margin: 0; min-height: 100svh; display: grid; place-items: center; text-align: center; padding: 2rem; }
      img { border-radius: 12px; }
      h1 { font-size: 1.6rem; letter-spacing: .06em; margin: .8rem 0 1.6rem; font-weight: 600; }
      a { display: inline-block; margin: .3rem; padding: .7rem 1.4rem; border: 1px solid #4a5273; border-radius: 999px; color: #f1e8d4; text-decoration: none; font: 500 .9rem ui-monospace, Menlo, monospace; }
      a:hover, a:focus-visible { border-color: #f1e8d4; background: rgb(241 232 212 / .1); }
    </style>
  </head>
  <body>
    <main>
      <img src={url('/favicon.svg')} alt="" width="64" height="64" />
      <h1>NightJar.Gift</h1>
      <p>{langs.map((l) => <a href={targets[l]} lang={l} hreflang={l}>{en.ui.langName[l]}</a>)}</p>
    </main>
  </body>
</html>
