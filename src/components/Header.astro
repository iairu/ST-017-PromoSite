---
import Icon from './Icon.astro';
import Banner from './Banner.astro';
import { url } from '../data/site.js';
import { content, getLang, href, langs, switchPath } from '../i18n/index.js';
const { langHome = false } = Astro.props; // pages without a counterpart (404): the switcher goes to the other home page
const lang = getLang(Astro);
const { nav, site, ui } = content(lang);
const path = Astro.url.pathname.replace(url('/').replace(/\/$/, ''), '').replace(`/${lang}`, '') || '/';
const active = (h) => (h === '/' ? path === '/' : path.startsWith(h));
---
<header class="hdr" id="top">
  <Banner />
  <div class="wrap bar">
    <a class="brand" href={href(lang)} aria-label={ui.homeAria}>
      <span class="brand-mark"><img src={url('/favicon.svg')} alt="" width="30" height="30" /></span>
      <span class="brand-text"><span class="brand-name">{site.brand}{site.brandTail && <span class="tail">{site.brandTail}</span>}</span>{site.brandSub && <small class="brand-sub">{site.brandSub}</small>}</span>
    </a>
    <nav id="primary-nav" aria-label={ui.mainNav}>
      <ul>
        {nav.map((n) => (
          <li>
            <a href={href(lang, n.href)} aria-current={active(n.href) ? 'page' : undefined} class:list={[{ cta: n.pill }]}>
              {n.label}{n.pill && <span class="pill soon">{n.pill}</span>}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="tools">
      <button class="icon-btn search-open" type="button" aria-label={ui.searchOpen} data-search-open>
        <Icon name="search" size={20} />
        <span class="hint"><span class="kbd">Ctrl</span><span class="kbd">K</span></span>
      </button>
      <div class="lang" role="group" aria-label={ui.language}>
        {langs.map((l) => l === lang
          ? <span class="cur" lang={l} aria-current="true" title={ui.langName[l]}>{l.toUpperCase()}</span>
          : <a href={langHome ? href(l) : switchPath(Astro.url.pathname, l)} lang={l} hreflang={l} data-lang-switch={l} title={ui.langName[l]} aria-label={ui.langName[l]}>{l.toUpperCase()}</a>)}
      </div>
      <button class="icon-btn" type="button" id="theme-toggle" aria-label={ui.theme} data-to-light={ui.toLight} data-to-dark={ui.toDark} data-light-title={ui.lightTitle} data-dark-title={ui.darkTitle}>
        <span class="ic-sun"><Icon name="sun" size={20} /></span>
        <span class="ic-moon"><Icon name="moon" size={20} /></span>
      </button>
      <button class="icon-btn menu-btn" type="button" aria-expanded="false" aria-controls="primary-nav" aria-label={ui.menu}>
        <span class="ic-open"><Icon name="menu" size={22} /></span>
        <span class="ic-close"><Icon name="close" size={22} /></span>
      </button>
    </div>
  </div>
</header>

<style>
  .hdr { position: fixed; inset: 0 0 auto 0; z-index: 90; background: color-mix(in srgb, #0d0f18 82%, transparent); backdrop-filter: blur(14px) saturate(1.3); -webkit-backdrop-filter: blur(14px) saturate(1.3); border-bottom: 1px solid rgb(241 232 212 / .1); color: #f1e8d4; }
  .bar { display: flex; align-items: center; gap: 1.2rem; height: 64px; }
  .brand { display: inline-flex; align-items: center; gap: .65rem; text-decoration: none; color: inherit; margin-right: auto; }
  .brand-mark { flex: none; display: inline-flex; }
  .brand-mark img { border-radius: 8px; }
  .brand-name { font: 600 1.15rem var(--font-display); letter-spacing: .06em; white-space: nowrap; }
  .brand-text { display: flex; flex-direction: column; line-height: 1.1; }
  .tail { font-weight: 400; opacity: .8; }
  .brand-sub { font: 400 .66rem/1.2 var(--font-mono); letter-spacing: .04em; opacity: .75; margin-top: .15rem; white-space: nowrap; }
  nav ul { display: flex; gap: .15rem; list-style: none; margin: 0; padding: 0; }
  nav a { display: inline-flex; align-items: center; gap: .5rem; padding: .55rem .8rem; border-radius: 999px; color: #d9d0bb; text-decoration: none; font: 500 .8rem var(--font-mono); letter-spacing: .04em; white-space: nowrap; }
  nav a:hover { color: #fff; background: rgb(241 232 212 / .09); }
  nav a[aria-current='page'] { color: #fff; background: rgb(241 232 212 / .14); }
  nav .pill { font-size: .58rem; padding: .35em .6em; color: #f0a070; }
  .tools { display: flex; align-items: center; gap: .3rem; }
  .icon-btn { display: inline-flex; align-items: center; gap: .55rem; background: none; border: 1px solid transparent; color: #e8dfca; height: 40px; min-width: 40px; justify-content: center; padding: 0 .6rem; border-radius: 10px; cursor: pointer; }
  .icon-btn:hover { background: rgb(241 232 212 / .1); }
  .search-open { border-color: rgb(241 232 212 / .2); padding: 0 .7rem; }
  .hint { display: inline-flex; gap: .2rem; }
  @media (max-width: 1360px) { .hint { display: none; } }
  .hint :global(.kbd) { background: transparent; color: #cfc6b2; border-color: rgb(241 232 212 / .3); }
  :global(:root[data-theme='dark']) .ic-moon, :global(:root:not([data-theme='dark'])) .ic-sun { display: none; }
  .lang { display: inline-flex; padding: 3px; border: 1px solid rgb(241 232 212 / .2); border-radius: 999px; margin-inline: .2rem; }
  .lang a, .lang .cur { font: 500 .7rem/1 var(--font-mono); letter-spacing: .06em; padding: .55em .7em; border-radius: 999px; text-decoration: none; min-width: 2.3rem; text-align: center; }
  .lang a { color: #d9d0bb; }
  .lang a:hover { color: #fff; background: rgb(241 232 212 / .12); }
  .lang .cur { background: rgb(241 232 212 / .2); color: #fff; }
  .menu-btn, .ic-close { display: none; }
  @media (max-width: 1180px) {
    .menu-btn { display: inline-flex; }
    .menu-btn[aria-expanded='true'] .ic-open { display: none; }
    .menu-btn[aria-expanded='true'] .ic-close { display: inline; }
    nav { position: fixed; inset: calc(64px + var(--bnr)) 0 auto 0; background: #0d0f18; border-bottom: 1px solid rgb(241 232 212 / .12); padding: .8rem var(--gutter) 1.4rem; display: none; max-height: calc(100dvh - 64px - var(--bnr)); overflow: auto; }
    nav.open { display: block; }
    nav ul { flex-direction: column; gap: .1rem; }
    nav a { font-size: 1rem; padding: .85rem .6rem; width: 100%; border-radius: 10px; }
    :global(.js) nav { display: none; } :global(.js) nav.open { display: block; }
    :global(html:not(.js)) nav { position: static; display: block; padding: 0; border: 0; background: none; }
    :global(html:not(.js)) .bar { flex-wrap: wrap; height: auto; padding-block: .6rem; }
    :global(html:not(.js)) nav ul { flex-direction: row; flex-wrap: wrap; }
  }
  @media (max-width: 560px) {
    .bar { gap: .5rem; }
    .brand { gap: .45rem; }
    .brand-name { font-size: 1rem; letter-spacing: .03em; }
    .tail, .brand-sub { display: none; }
    .tools { gap: .1rem; }
    .icon-btn { min-width: 36px; padding: 0 .45rem; }
    .lang { margin-inline: .1rem; }
    .lang a, .lang .cur { min-width: 1.9rem; padding: .55em .5em; }
  }
</style>
