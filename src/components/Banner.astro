---
import Icon from './Icon.astro';
import { links } from '../data/site.js';
// Bump the id in Base.astro (lelek-banner = 'knifes-1') together with this one to show a new banner to people who dismissed the old one.
---
<div class="bnr" id="banner" role="region" aria-label="Announcement">
  <a class="msg" href={links.docs} target="_blank" rel="noopener noreferrer">
    <span class="tag">New</span>
    <span class="txt">
      <b>The whole build is documented in the open.</b>
      <span class="long"> Every board version, dead end and fix lives in the KNIFES docs.</span>
      <span class="short"> Read the KNIFES docs →</span>
    </span>
    <span class="go">Read KNIFES <span class="dom">· knifes.nightjar.gift</span> <Icon name="arrow" size={14} /></span>
  </a>
  <button class="x" id="banner-close" type="button" aria-label="Dismiss this announcement"><Icon name="close" size={16} /></button>
</div>

<style>
  .bnr { position: relative; height: var(--bnr); overflow: hidden; background: linear-gradient(90deg, #86401f 0%, #a9582b 55%, #b8692f 100%); color: #fff; border-bottom: 1px solid rgb(0 0 0 / .18); }
  :global(html.no-banner) .bnr { display: none; }
  .msg { height: 100%; display: flex; align-items: center; justify-content: center; gap: .8rem; padding: 0 3rem; color: inherit; text-decoration: none; font: 400 .98rem/1.2 var(--font-body); }
  .msg:hover .go { text-decoration: underline; text-underline-offset: .25em; }
  .tag { font: 600 .62rem/1 var(--font-mono); letter-spacing: .14em; text-transform: uppercase; background: #fff; color: #7a3a1b; padding: .4em .65em; border-radius: 999px; flex: none; }
  .txt { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .txt b { font-weight: 600; }
  .go { flex: none; font: 500 .74rem/1 var(--font-mono); letter-spacing: .06em; text-transform: uppercase; display: inline-flex; align-items: center; gap: .5rem; border: 1px solid rgb(255 255 255 / .6); border-radius: 999px; padding: .55em .9em; }
  .short { display: none; text-decoration: underline; text-underline-offset: .2em; }
  .dom { opacity: .85; text-transform: none; letter-spacing: 0; }
  .x { position: absolute; right: .6rem; top: 50%; transform: translateY(-50%); display: none; width: 34px; height: 34px; border: 0; border-radius: 50%; background: transparent; color: #fff; cursor: pointer; place-items: center; }
  :global(.js) .x { display: grid; }
  .x:hover { background: rgb(255 255 255 / .18); }
  .msg:focus-visible, .x:focus-visible { outline: 3px solid #fff; outline-offset: -3px; }
  @media (max-width: 900px) { .dom, .long { display: none; } }
  @media (max-width: 640px) {
    .msg { gap: .55rem; padding: 0 2.6rem 0 .8rem; font-size: .88rem; justify-content: flex-start; }
    .txt { white-space: normal; line-height: 1.2; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
    .go { display: none; }
    .short { display: inline; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .tag { animation: nudge 3.2s ease-in-out infinite; }
    @keyframes nudge { 0%, 88%, 100% { transform: none; } 92% { transform: scale(1.12); } 96% { transform: scale(1); } }
  }
</style>
