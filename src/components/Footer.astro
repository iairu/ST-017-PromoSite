---
import Icon from './Icon.astro';
import { nav, external, links, site, url } from '../data/site.js';
const year = new Date().getFullYear();
---
<footer class="ftr" id="footer">
  <div class="wrap">
    <div class="top">
      <div class="about">
        <a class="brand" href={url('/')}><img src={url('/favicon.svg')} alt="" width="34" height="34" /><span>LELEK</span></a>
        <p class="latin">{site.latin}</p>
        <p class="small">A wooden nightjar that sings when you press its back. A student project in digital fabrication at FIIT STU, Bratislava.</p>
        <p class="small"><span class="pill wip">Prototype in progress</span></p>
        <button class="btn ghost" type="button" data-search-open><Icon name="search" size={16} /> Search the site <span class="kbd">Ctrl K</span></button>
      </div>
      <nav class="map" aria-label="Sitemap">
        <h2 class="sr-only">Sitemap</h2>
        <div class="cols">
          {nav.map((n) => (
            <div class="col">
              <h3><a href={url(n.href)}>{n.label}</a></h3>
              <ul>
                {n.sections.map(([id, label]) => (
                  <li><a href={url(n.href) + '#' + id}>{label}</a></li>
                ))}
              </ul>
            </div>
          ))}
          <div class="col">
            <h3>Elsewhere</h3>
            <ul>
              {external.map((e) => (
                <li><a href={e.href} target="_blank" rel="noopener noreferrer">{e.label} <Icon name="ext" size={12} /></a></li>
              ))}
              <li><a href={links.github} target="_blank" rel="noopener noreferrer">GitHub: iairu <Icon name="ext" size={12} /></a></li>
              <li><a href={links.portfolio} target="_blank" rel="noopener noreferrer">iairu.com <Icon name="ext" size={12} /></a></li>
              <li><a href={`mailto:${links.email}`}>{links.email}</a></li>
            </ul>
          </div>
        </div>
      </nav>
    </div>
    <div class="bottom">
      <p>© {year} Ondrej Špánik · {site.studentId} · {site.course}, {site.year}. Text and documentation under {site.licence}.</p>
      <p>Nothing on this site is an offer for sale. Prices are targets and prices of parts as read on the dates shown. Last updated {site.updated}.</p>
      <p><a href="#top">Back to top ↑</a></p>
    </div>
  </div>
</footer>

<style>
  .ftr { background: var(--dusk); color: #cfc6b2; padding: clamp(3rem, 6vw, 5rem) 0 2rem; border-top: 1px solid #2a2f45; font-size: .95rem; }
  .top { display: grid; gap: 3rem; grid-template-columns: minmax(240px, 1fr) 3fr; }
  .brand { display: inline-flex; align-items: center; gap: .7rem; color: #f1e8d4; text-decoration: none; font: 600 1.3rem var(--font-display); letter-spacing: .28em; margin-bottom: .3rem; }
  .brand img { border-radius: 8px; }
  .latin { color: #d7b98d; margin: 0 0 1rem; }
  .small { font-size: .92rem; max-width: 34ch; }
  .cols { display: grid; gap: 2rem 1.5rem; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); }
  h3 { font: 500 .72rem var(--font-mono); letter-spacing: .14em; text-transform: uppercase; color: #d7b98d; margin-bottom: .9rem; }
  h3 a { color: inherit; text-decoration: none; } h3 a:hover { color: #fff; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: .5rem; }
  .col a { color: #cfc6b2; text-decoration: none; }
  .col a:hover { color: #fff; text-decoration: underline; }
  .bottom { margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid #2a2f45; display: flex; flex-wrap: wrap; gap: .4rem 2rem; justify-content: space-between; font: 400 .78rem/1.6 var(--font-mono); color: #9d9684; }
  .bottom p { margin: 0; max-width: 62ch; }
  .bottom a { color: #d7b98d; }
  .ghost { --fg: #f1e8d4; --bd: #4a5273; margin-top: .6rem; }
  .ghost :global(.kbd) { background: transparent; color: #cfc6b2; border-color: #4a5273; }
  @media (max-width: 900px) { .top { grid-template-columns: 1fr; } }
</style>
