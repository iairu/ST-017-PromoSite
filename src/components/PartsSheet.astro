---
// Simple 3D-style vector drawings of the kit parts, generated by scripts/parts_svg.py into
// public/img/parts/. Fixed colours on purpose: they sit on a light plate in both themes.
import { url } from '../data/site.js';
const parts = [
  { id: 'dfplayer', name: 'DFPlayer Pro', ref: 'U2', note: 'DFR0768 · MP3 player, amplifier, 128 MB flash' },
  { id: 'speaker', name: 'Speaker', ref: 'LS1', note: '8 Ω · 0.5 W · 40 mm · leads to solder' },
  { id: 'battery', name: 'LiPo cell', ref: 'J1', note: '500 mAh · 3.7 V · protection PCB · JST-PH' },
  { id: 'capacitor', name: 'Capacitor', ref: 'C1', note: '470 µF · 16 V · 8 x 12 mm' },
  { id: 'resistors', name: 'Resistors', ref: 'R1, R2', note: '10 Ω · 1/4 W · taped strip of 10' },
  { id: 'button', name: 'Tact switch', ref: 'SW1', note: '12 x 12 x 4.3 mm' },
  { id: 'header-f', name: 'Female header', ref: 'U2', note: '1 x 40, 2.54 mm · cut to two 6-pin pieces' },
  { id: 'header-m', name: 'Pin headers', ref: '', note: 'Male, 2.54 mm · two strips' },
  { id: 'breadboard', name: 'Breadboard', ref: '', note: '830 points · for the v7 test build' },
  { id: 'sd', name: 'microSD + adapter', ref: '', note: 'Spare card for sound files' },
  { id: 'jumper', name: 'Jumper wires', ref: '', note: 'Male and female ends, mixed colours' },
];
---
<div class="parts-sheet">
  {parts.map((p) => (
    <figure class="part reveal">
      <img src={url(`/img/parts/${p.id}.svg`)} alt={`${p.name}, simple 3D drawing`} width="240" height="160" loading="lazy" decoding="async" />
      <figcaption><b>{p.name}</b>{p.ref && <span class="ref"> · {p.ref}</span>}<br />{p.note}</figcaption>
    </figure>
  ))}
</div>

<style>
  .parts-sheet { display: grid; gap: clamp(.8rem, 1.6vw, 1.2rem); grid-template-columns: repeat(auto-fill, minmax(min(100%, 230px), 1fr)); }
  .part { background: var(--plate); border: 1px solid var(--rule); border-radius: 12px; padding: .9rem .9rem 1rem; box-shadow: var(--shadow); color: #2b2118; }
  .part img { width: 100%; height: auto; }
  .part figcaption { color: #5b4c3c; margin-top: .4rem; }
  .part figcaption b { color: #2b2118; }
  .ref { color: #9c4f2a; }
</style>
