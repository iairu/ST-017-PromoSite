---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { bom, fuse, wood, url, links } from '../data/site.js';
const eur = (n) => n.toFixed(2).replace('.', ',');
const fmt = (n) => new Intl.NumberFormat('en-GB', { style: 'currency', currency: 'EUR' }).format(n);
---
<Base title="Parts" description="Every part inside LELEK: the v7 electronics bill of materials (ordered, EUR 17.60 including VAT), the beech block and the optional v8 thermal fuse, with shops and links.">
  <PageHero crumb="Parts" eyebrow="What goes inside" title="Nine lines of electronics, <em>one block of beech.</em>" lead={`The v7 parts have been ordered. Prices were read on ${bom.date} in euro including VAT, without shipping, and stock changes, so check the cart.`} />

  <section class="block" id="electronics-parts">
    <div class="wrap">
      <div class="sec-head reveal">
        <p class="eyebrow">Electronics <span class="pill ok" style="margin-left:.6rem">Ordered</span></p>
        <h2>Board v7: {fmt(bom.total)} plus shipping.</h2>
        <p>Two shops, nine lines. No microcontroller, no MOSFET, no LED, no firmware. Against roughly USD 31.50 net for v6 at TME.</p>
      </div>
      {bom.shops.map((shop) => (
        <div class="reveal shop">
          <h3><a href={shop.url} target="_blank" rel="noopener noreferrer">{shop.name} <Icon name="ext" size={14} /></a> <span class="mono sub">subtotal {fmt(shop.subtotal)}</span></h3>
          <div class="table-wrap">
            <table>
              <thead><tr><th>Ref</th><th>Part</th><th class="num">Qty</th><th class="num">Price</th><th>Why</th></tr></thead>
              <tbody>
                {shop.rows.map(([ref, part, qty, price, href, note]) => (
                  <tr><td class="ref">{ref}</td><td><a href={href} target="_blank" rel="noopener noreferrer">{part}</a></td><td class="num">{qty}</td><td class="num">{eur(price)}</td><td>{note}</td></tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      ))}
      <div class="total reveal"><span class="mono">Total, both shops</span><strong>{fmt(bom.total)}</strong></div>
      <div class="prose reveal">
        <h3>Worth knowing</h3>
        <ul>
          <li>The charger module ships with a 1.2 kΩ charge-current resistor. Replace it with the 3.3 kΩ part before first use, and check what you got: some arrive with a wrong value.</li>
          <li>The battery has a JST-PH plug. Plug colours are not a standard, so verify the red wire is + with a meter before cutting it off.</li>
          <li>Solder R1 and R2 first: they lie flat under the DFPlayer Pro, between its pin rows.</li>
          <li>The DFPlayer Pro's USB-C is for loading the sound file only, with the battery disconnected. Charge only through the charger module.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="block tint" id="wood-parts">
    <div class="wrap">
      <div class="sec-head reveal">
        <p class="eyebrow">Wood and workshop</p>
        <h2>The blank, the dowels and the button.</h2>
        <p>The beech block is the likely order: cut into pieces, it gives the two halves and the button blank from a single 80 x 80 x 800 mm piece.</p>
      </div>
      <div class="grid g3">
        {wood.map((w) => (
          <article class="card reveal">
            <p><span class:list={['pill', w.status === 'Planned' ? 'ok' : 'todo']}>{w.status}</span></p>
            <h3>{w.title}</h3>
            <p class="mono small">{w.shop} · {w.price}</p>
            <p>{w.text}</p>
            <p><a href={w.url} target="_blank" rel="noopener noreferrer">View at {w.shop} <Icon name="ext" size={14} /></a></p>
          </article>
        ))}
      </div>
      <div class="table-wrap reveal" style="margin-top:2rem">
        <table>
          <thead><tr><th>Item</th><th class="num">Qty</th><th>Notes</th></tr></thead>
          <tbody>
            <tr><td>Hardwood blanks, 329 x 95 x 48 mm</td><td class="num">2</td><td>Beech or linden, grain along the length.</td></tr>
            <tr><td>Hardwood for the button</td><td class="num">1</td><td>About 25 x 25 x 50 mm.</td></tr>
            <tr><td>Beech dowels, 6 x 19 mm</td><td class="num">4</td><td>Cut 10 + 9 mm, chamfered at both ends.</td></tr>
            <tr><td>EVA foam or felt, 3 mm</td><td class="num">1</td><td>About 30 x 25 mm, presses the board down.</td></tr>
            <tr><td>Micro-USB cable</td><td class="num">1</td><td>Plug body at most 12.5 x 7 mm to fit the port channel.</td></tr>
          </tbody>
        </table>
      </div>
      <p class="note reveal">Wood prices were read on 5 October 2026, include VAT and exclude shipping. Delivery, cut-to-length services and minimum orders are not yet verified.</p>
    </div>
  </section>

  <section class="block" id="v8-fuse">
    <div class="wrap split" style="align-items:start">
      <div class="reveal">
        <p class="eyebrow">Board v8</p>
        <h2>One more part: a thermal fuse.</h2>
        <p>Version 8 adds {fuse.ref}, a one-shot {fuse.part.toLowerCase()}, in the battery line. It brings the electronics to about {fmt(fuse.total)}.</p>
      </div>
      <div class="card reveal">
        <p class="mono small">{fuse.shop}</p>
        <h3>{fuse.part}</h3>
        <p>{fmt(fuse.price)} for one piece. 10 A, 250 V, body 11.5 x 4.2 mm. Not sold by techfun.sk or LaskaKit, so it is a third small order.</p>
        <p><a href={fuse.url} target="_blank" rel="noopener noreferrer">View at {fuse.shop} <Icon name="ext" size={14} /></a></p>
      </div>
    </div>
  </section>
</Base>

<style>
  .shop { margin-bottom: 2.4rem; }
  .shop h3 { display: flex; flex-wrap: wrap; align-items: baseline; gap: .4rem 1rem; }
  .sub { font-size: .78rem; color: var(--bark); }
  .total { display: flex; justify-content: space-between; align-items: baseline; padding: 1.2rem 1.4rem; border: 2px solid var(--ink); border-radius: 12px; margin-bottom: 2.4rem; }
  .total strong { font: 600 clamp(1.6rem, 1.2rem + 1.6vw, 2.4rem) var(--font-display); }
  .small { font-size: .78rem; color: var(--bark); }
</style>
