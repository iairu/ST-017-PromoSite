---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { milestones, status, links, url } from '../data/site.js';
const label = { done: 'Done', wip: 'In progress', todo: 'Not started' };
---
<Base title="Roadmap" description="Where the LELEK build stands: electronics designed and ordered, enclosure modelled, wood chosen, CNC carving next. Milestones from October 2026 to January 2027.">
  <PageHero crumb="Roadmap" eyebrow="Where the build stands" title="Designed and ordered. <em>Not yet carved.</em>" lead="An honest picture, updated as things happen. The plan runs from the project's approval on 5 October 2026 to the final presentation in January 2027." />

  <section class="block" id="status">
    <div class="wrap">
      <div class="sec-head reveal"><p class="eyebrow">Status</p><h2>What exists today.</h2><p>As of {`5 October 2026`}.</p></div>
      <div class="table-wrap reveal">
        <table>
          <thead><tr><th>Area</th><th>State</th><th>Notes</th></tr></thead>
          <tbody>
            {status.map(([area, note, st]) => (
              <tr><td><b>{area}</b></td><td><span class={`pill ${st === 'done' ? 'ok' : st}`}>{label[st]}</span></td><td>{note}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="note reveal"><b>Not yet true:</b> there is no physical bird. The first sound from a real breadboard is the target of milestone M3, and no battery life or loudness figures have been measured.</p>
    </div>
  </section>

  <section class="block tint" id="milestones">
    <div class="wrap">
      <div class="sec-head reveal"><p class="eyebrow">Milestones</p><h2>Eight steps to a singing bird.</h2></div>
      <ol class="tl">
        {milestones.map((m) => (
          <li class:list={['reveal', { done: m.done }]}>
            <span class="dot" aria-hidden="true">{m.done ? <Icon name="check" size={14} /> : ''}</span>
            <p class="mono when">{m.id} · <time datetime={m.iso}>{m.date}</time> {m.done && <span class="pill ok">Reached</span>}</p>
            <h3>{m.title}</h3>
            <p>{m.text}</p>
          </li>
        ))}
      </ol>
      <p class="reveal"><a class="btn ghost" href={links.docs} target="_blank" rel="noopener noreferrer">Full project documentation <Icon name="ext" size={14} /></a></p>
    </div>
  </section>
</Base>

<style>
  .tl { list-style: none; margin: 0 0 2.4rem; padding: 0 0 0 2rem; border-left: 1px solid var(--rule); display: grid; gap: 2.2rem; max-width: 760px; }
  .tl li { position: relative; }
  .tl .dot { position: absolute; left: calc(-2rem - 9px); top: .2rem; width: 17px; height: 17px; border-radius: 50%; background: var(--paper-2); border: 2px solid var(--rule); display: grid; place-items: center; color: #fff; }
  .tl li.done .dot { background: var(--moss); border-color: var(--moss); }
  .when { margin: 0 0 .3rem; font-size: .76rem; letter-spacing: .08em; color: var(--bark); text-transform: uppercase; display: flex; gap: .8rem; align-items: center; flex-wrap: wrap; }
  .tl h3 { margin-bottom: .2em; } .tl p:last-child { margin: 0; color: var(--ink-soft); }
</style>
