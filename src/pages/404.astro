---
// Served by the host for every unknown address, in any language, so it shows both languages.
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { content, href } from '../i18n/index.js';
const en = content('en').p.notFound;
const sk = content('sk').p.notFound;
---
<Base lang="en" title={en.title} noindex alternates={false}>
  <PageHero crumb={en.crumb} eyebrow={en.eyebrow} title={en.heading} lead={en.lead} />
  <section class="block">
    <div class="wrap">
      <p><a class="btn primary" href={href('en')}>{en.back}</a></p>
      <p lang="sk" style="margin-top:2rem">{sk.lead} <a class="btn ghost" href={href('sk')}>{sk.back}</a></p>
    </div>
  </section>
</Base>
