---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Fig from '../components/Fig.astro';
import ModelViewer from '../components/ModelViewer.astro';
import Icon from '../components/Icon.astro';
import { specs, pockets, wood, url, links } from '../data/site.js';
---
<Base title="The Bird" description="The LELEK nightjar: a stylised perching bird carved from two beech halves on a 3-axis CNC. Dimensions, wireframes, pockets, machining and wood.">
  <PageHero crumb="The Bird" eyebrow="Shape, wood and CNC" title="A perching nightjar, <em>carved in two halves.</em>" lead="The body is a stylised nightjar: flat-headed, long-tailed, sitting low along its branch. It is split down the middle so that every cavity can be cut from the seam, then glued around the electronics." />

  <section class="block" id="specs">
    <div class="wrap split" style="align-items:start">
      <div class="reveal">
        <p class="eyebrow">Specifications</p>
        <h2>309 millimetres of beech.</h2>
        <p>The numbers below come straight from the parametric model that generates the CNC files. Change a parameter, rerun the script, and the walls, pockets and fit checks are recomputed.</p>
        <p class="note"><b>Prototype.</b> Nothing has been machined yet. These are design figures from the model, not measurements of a finished bird.</p>
      </div>
      <div class="table-wrap reveal">
        <table class="specs"><tbody>
          {specs.map(([k, v]) => <tr><td>{k}</td><td>{v}</td></tr>)}
        </tbody></table>
      </div>
    </div>
  </section>

  <section class="block night" id="model">
    <div class="wrap">
      <div class="sec-head reveal"><p class="eyebrow">3D model</p><h2>Drag it. Spin it. Look for the seam.</h2><p>The button on the back is its own part, in a darker wood.</p></div>
      <div class="reveal"><ModelViewer /></div>
    </div>
  </section>

  <section class="block" id="wireframes">
    <div class="wrap">
      <div class="sec-head reveal">
        <p class="eyebrow">Wireframes</p>
        <h2>Inside the carving.</h2>
        <p>Drawn from the same STL files as the 3D view, as stacks of cross-sections. Blue is the wood, orange is the button, and in the exploded view the board, charger, battery and speaker sit between the halves.</p>
      </div>
      <div class="grid g2">
        <Fig src="wire-assembled" w={1438} h={627} alt="Wireframe of the assembled bird with the orange button on its back" caption="<b>Assembled.</b> The wooden button in orange, the two halves in blue." />
        <Fig src="wire-front" w={1138} h={589} alt="Wireframe of the bird seen from the front and left" caption="<b>From the front and left.</b> The chest holds a 40 mm speaker with a sound chamber and grille slots in front of it." />
      </div>
      <div style="margin-top:clamp(1rem,2vw,1.6rem)">
        <Fig src="wire-exploded" w={1453} h={703} alt="Exploded wireframe: left half, board and parts, right half and button" caption="<b>Exploded.</b> Left half, electronics (green board, blue battery, red charger, purple speaker), right half and button." />
      </div>
    </div>
  </section>

  <section class="block tint" id="pockets">
    <div class="wrap">
      <div class="sec-head reveal">
        <p class="eyebrow">Pockets and depths</p>
        <h2>Every cavity is a flat-bottomed step.</h2>
        <p>Looking straight at the seam, each coloured contour is one pocket floor. All of them are cut with plain end mills before the half is flipped and the outside is carved.</p>
      </div>
      <div class="stack">
        <Fig src="pockets-left" w={1485} h={413} alt="Contour map of the left half's pockets seen from the split face, beak to the right" caption="<b>Left half</b>, looking at the split face, beak to the right. Includes the speaker pocket." />
        <Fig src="pockets-right" w={1485} h={398} alt="Contour map of the right half's pockets seen from the split face, beak to the left" caption="<b>Right half</b>, beak to the left. Has a sound chamber in front of the speaker instead of a pocket." />
      </div>
      <div class="table-wrap reveal" style="margin-top:2rem">
        <table>
          <thead><tr><th>Pocket</th><th>Half</th><th class="num">Depth from seam</th><th>Notes</th></tr></thead>
          <tbody>{pockets.map(([a, b, c, d]) => <tr><td><b>{a}</b></td><td>{b}</td><td class="num">{c}</td><td>{d}</td></tr>)}</tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="block" id="machining">
    <div class="wrap split" style="align-items:start">
      <div class="reveal">
        <p class="eyebrow">Machining</p>
        <h2>Carved seam-down, then flipped.</h2>
        <p class="lead">Both halves can be cut side by side from one board. The outside has no undercuts, so every point is reachable from above.</p>
      </div>
      <ol class="steps prose reveal">
        <li><b>Stock.</b> Plane each blank flat and square, 329 x 95 x 48 mm or thicker, grain along the length.</li>
        <li><b>Seam side up.</b> Face the top flat, cut the pockets deepest last with a 6 mm end mill, then slots, collar pocket and pry notches with a 3 mm one. Drill the four dowel holes 10 mm deep and two registration holes through the waste.</li>
        <li><b>Flip.</b> Turn the blank onto the spoilboard on two 6 mm pins. The seam face is now down and flat on the bed.</li>
        <li><b>Outside.</b> Rough with a 6 mm ball-nose leaving 1 mm, finish with a 3 mm ball-nose at 0.3 to 0.5 mm stepover. Leave 3 to 4 tabs about 3 mm thick on the outline.</li>
        <li><b>Mirror, but not quite.</b> The right half mirrors the left on the outside, but its pockets differ, so it has its own toolpath.</li>
        <li><b>Finish.</b> Cut the tabs, sand to 240, keep the seam faces sharp, then oil or wax the outside, never the pockets.</li>
      </ol>
    </div>
  </section>

  <section class="block tint" id="button">
    <div class="wrap split">
      <div class="reveal">
        <p class="eyebrow">The wooden button</p>
        <h2>A small dome with a square stem.</h2>
        <p>Turned from hardwood (beech, maple or box), an 18 mm dome sits on an 8 x 8 mm square stem that runs straight down the seam onto the switch. The square section stops it turning.</p>
        <ul class="prose">
          <li>35.3 mm from dome base to stem tip.</li>
          <li>A 14 x 14 x 3 mm collar, captured in its own pocket, gives 0.5 mm of free travel before it bottoms out (the switch needs 0.25 mm) and 0.5 mm of lift before it hits the roof, so it cannot fall out.</li>
          <li>The stem length assumes the 4.3 mm tall 12 x 12 mm switch.</li>
        </ul>
      </div>
      <div class="card reveal">
        <h3>Closing the bird</h3>
        <p>Four 6 x 19 mm beech dowels are glued into the right half only. The left half's holes are eased so the fit is snug but not glued.</p>
        <p>To open it again, a thin flat blade goes into one of the pry notches on the belly seam and is twisted gently, working the halves apart evenly front and back.</p>
      </div>
    </div>
  </section>

  <section class="block" id="wood">
    <div class="wrap">
      <div class="sec-head reveal">
        <p class="eyebrow">Wood</p>
        <h2>Beech, from a square block.</h2>
        <p>Kiln-dried hardwood at 8 to 10 % moisture, because builders' timber is wet, twists and fuzzes under a cutter. Prices were read on 5 October 2026, include VAT and exclude shipping.</p>
      </div>
      <div class="grid g3">
        {wood.map((w) => (
          <article class="card reveal">
            <p><span class:list={['pill', w.status === 'Planned' ? 'ok' : 'todo']}>{w.status}</span></p>
            <h3>{w.title}</h3>
            <p class="mono small">{w.shop} · {w.price}</p>
            <p>{w.text}</p>
            <p><a href={w.url} target="_blank" rel="noopener noreferrer">View at {w.shop} <Icon name="ext" size={14} /></a></p>
          </article>
        ))}
      </div>
      <p class="note reveal">Not yet verified: delivery cost, cut-to-length and planing services, minimum orders.</p>
    </div>
  </section>
</Base>

<style>
  .stack { display: grid; gap: 1.4rem; }
  .steps { counter-reset: s; list-style: none; padding: 0; display: grid; gap: 1.1rem; max-width: none; }
  .steps li { counter-increment: s; padding-left: 3.2rem; position: relative; margin: 0; }
  .steps li::before { content: counter(s); position: absolute; left: 0; top: .1rem; width: 2.2rem; height: 2.2rem; border: 1px solid var(--rust); color: var(--rust); border-radius: 50%; display: grid; place-items: center; font: 500 .8rem var(--font-mono); }
  .small { font-size: .78rem; color: var(--bark); }
</style>
