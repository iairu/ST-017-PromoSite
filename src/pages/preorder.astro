---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { faq, links, PREORDER_OPEN } from '../data/site.js';
const off = !PREORDER_OPEN ? true : undefined;
---
<Base title="Pre-order" description="Pre-orders for the LELEK wooden nightjar are not open yet. Target price EUR 89 to 129, made to order; see the planned options and questions.">
  <PageHero crumb="Pre-order" eyebrow="Opening soon" title="Reserve a bird. <em>Not yet.</em>" lead="Each LELEK will be made to order. The form below shows how pre-ordering will work; it is switched off until the first prototype has been carved and the price is confirmed." />

  <section class="block" id="form">
    <div class="wrap order">
      <form class="card" aria-describedby="closed" onsubmit="return false" novalidate>
        <div class="closed" id="closed" role="status">
          <Icon name="lock" size={20} />
          <p><b>Pre-orders are closed for now.</b> Nothing you type here is sent anywhere. Interested? <a href={`mailto:${links.email}?subject=LELEK%20pre-order%20interest`}>Send an email</a> and you will be told when it opens.</p>
        </div>
        <fieldset disabled={off}>
          <legend class="sr-only">Pre-order details</legend>
          <div class="field">
            <span class="lab" id="wood-l">Wood</span>
            <div class="choices" role="radiogroup" aria-labelledby="wood-l">
              <label class="choice"><input type="radio" name="wood" value="beech" checked /><span><b>Beech</b><small>Hard, fine-grained. The final bird.</small></span></label>
              <label class="choice"><input type="radio" name="wood" value="linden" /><span><b>Linden</b><small>Soft and pale. Used for the prototype.</small></span></label>
            </div>
          </div>
          <div class="row">
            <label class="field"><span class="lab">Quantity</span><input type="number" min="1" max="10" value="1" inputmode="numeric" /></label>
            <label class="field"><span class="lab">Dedication engraving <i>(optional)</i></span><input type="text" maxlength="40" placeholder="e.g. For Jana, summer 2027" /></label>
          </div>
          <div class="row">
            <label class="field"><span class="lab">Name</span><input type="text" autocomplete="name" placeholder="Your name" /></label>
            <label class="field"><span class="lab">Email</span><input type="email" autocomplete="email" placeholder="you@example.com" /></label>
          </div>
          <label class="field"><span class="lab">Country of delivery</span>
            <select><option>Slovakia</option><option>Czechia</option><option>Other (ask first)</option></select></label>
          <label class="check"><input type="checkbox" /> <span>I understand this is a made-to-order project, the price is confirmed before any payment, and I can withdraw at any time.</span></label>
          <button class="btn primary" type="submit" disabled aria-disabled="true"><Icon name="lock" size={16} /> Pre-orders open soon</button>
        </fieldset>
      </form>

      <aside class="price card">
        <p class="eyebrow">Target price</p>
        <p class="amount"><span>EUR</span> 89 – 129</p>
        <p class="mono small">per bird, made to order, hypothesis</p>
        <ul>
          <li>About EUR 35 of material</li>
          <li>EUR 17.60 of electronics (v7)</li>
          <li>Roughly 4 hours of work, CNC time included</li>
        </ul>
        <p class="note">This is the working estimate from the project's pitch, not an offer. The final price depends on what the prototype actually costs to make.</p>
      </aside>
    </div>
  </section>

  <section class="block tint" id="faq">
    <div class="wrap narrow">
      <div class="sec-head reveal"><p class="eyebrow">Questions</p><h2>Before you ask.</h2></div>
      <div class="faq">
        {faq.map(([q, a]) => (
          <details class="reveal"><summary>{q}</summary><p>{a}</p></details>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .order { display: grid; gap: clamp(1.4rem, 3vw, 2.4rem); grid-template-columns: 1.6fr 1fr; align-items: start; }
  @media (max-width: 900px) { .order { grid-template-columns: 1fr; } }
  .closed { display: flex; gap: .9rem; align-items: flex-start; padding: 1rem 1.1rem; border-radius: 10px; background: color-mix(in srgb, var(--amber) 16%, var(--paper)); border: 1px solid color-mix(in srgb, var(--amber) 55%, transparent); margin-bottom: 1.6rem; }
  .closed p { margin: 0; font-size: .98rem; } .closed :global(svg) { margin-top: .2rem; color: var(--amber); }
  fieldset { border: 0; padding: 0; margin: 0; min-width: 0; display: grid; gap: 1.2rem; }
  fieldset[disabled] { opacity: .62; }
  .row { display: grid; gap: 1.2rem; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); }
  .field { display: grid; gap: .4rem; }
  .lab { font: 500 .72rem var(--font-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--bark); }
  .lab i { text-transform: none; letter-spacing: 0; font-family: var(--font-body); }
  input[type='text'], input[type='email'], input[type='number'], select { font: inherit; color: var(--ink); background: var(--paper); border: 1px solid var(--rule); border-radius: 10px; padding: .75rem .9rem; width: 100%; min-height: 46px; }
  input:disabled, select:disabled { cursor: not-allowed; }
  .choices { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: .8rem; }
  .choice { display: flex; gap: .8rem; align-items: flex-start; border: 1px solid var(--rule); border-radius: 12px; padding: .9rem 1rem; background: var(--paper); cursor: pointer; }
  .choice:has(input:checked) { border-color: var(--rust); box-shadow: 0 0 0 1px var(--rust) inset; }
  .choice small { display: block; color: var(--ink-soft); font-size: .88rem; }
  .check { display: flex; gap: .7rem; align-items: flex-start; font-size: .95rem; color: var(--ink-soft); }
  .check input { margin-top: .35rem; width: 1.1rem; height: 1.1rem; }
  .price .amount { font: 500 clamp(2.4rem, 2rem + 2vw, 3.4rem)/1 var(--font-display); letter-spacing: -.02em; margin: 0 0 .3rem; }
  .price .amount span { font: 500 .9rem var(--font-mono); letter-spacing: .1em; color: var(--bark); }
  .small { font-size: .76rem; color: var(--bark); }
  .price ul { padding-left: 1.2rem; } .price li::marker { color: var(--rust); }
  .faq { display: grid; gap: .8rem; }
  details { border: 1px solid var(--rule); border-radius: 12px; background: var(--paper); padding: 0 1.2rem; }
  summary { cursor: pointer; padding: 1.1rem 0; font: 560 1.15rem var(--font-display); list-style: none; display: flex; justify-content: space-between; gap: 1rem; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; font: 400 1.5rem/1 var(--font-mono); color: var(--rust); transition: transform .2s; }
  details[open] summary::after { transform: rotate(45deg); }
  details p { margin: 0 0 1.2rem; color: var(--ink-soft); }
</style>
