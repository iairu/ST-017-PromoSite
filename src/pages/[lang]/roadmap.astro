---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import { content, getLang, fill } from '../../i18n/index.js';
export const getStaticPaths = () => [{ params: { lang: 'en' } }, { params: { lang: 'sk' } }];
const lang = getLang(Astro);
const c = content(lang);
const { milestones, status, links, ui, site } = c;
const t = c.p.roadmap;
---
<Base title={t.title} description={t.description}>
  <PageHero crumb={t.title} eyebrow={t.hero.eyebrow} title={t.hero.title} lead={t.hero.lead} />

  <section class="block" id="status">
    <div class="wrap">
      <div class="sec-head reveal"><p class="eyebrow">{t.status.eyebrow}</p><h2>{t.status.title}</h2><p>{fill(t.status.asOf, { date: site.updated })}</p></div>
      <div class="table-wrap reveal">
        <table>
          <thead><tr><th>{t.status.cols[0]}</th><th>{t.status.cols[1]}</th><th>{t.status.cols[2]}</th></tr></thead>
          <tbody>
            {status.map((s) => (
              <tr><td><b>{s.area}</b></td><td><span class={`pill ${s.state === 'done' ? 'ok' : s.state}`}>{ui.status[s.state]}</span></td><td>{s.note}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="note reveal" set:html={t.status.note} />
    </div>
  </section>

  <section class="block tint" id="milestones">
    <div class="wrap">
      <div class="sec-head reveal"><p class="eyebrow">{t.milestones.eyebrow}</p><h2>{t.milestones.title}</h2></div>
      <ol class="tl">
        {milestones.map((m) => (
          <li class:list={['reveal', { done: m.done }]}>
            <span class="dot" aria-hidden="true">{m.done ? <Icon name="check" size={14} /> : ''}</span>
            <p class="mono when">{m.id} · <time datetime={m.iso}>{m.date}</time> {m.done && <span class="pill ok">{ui.pillReached}</span>}</p>
            <h3>{m.title}</h3>
            <p>{m.text}</p>
          </li>
        ))}
      </ol>
      <p class="reveal"><a class="btn ghost" href={links.docs} target="_blank" rel="noopener noreferrer">{t.milestones.docs} <Icon name="ext" size={14} /></a></p>
    </div>
  </section>
</Base>

<style>
  .tl { list-style: none; margin: 0 0 2.4rem; padding: 0 0 0 2rem; border-left: 1px solid var(--rule); display: grid; gap: 2.2rem; max-width: 760px; }
  .tl li { position: relative; }
  .tl .dot { position: absolute; left: calc(-2rem - 9px); top: .2rem; width: 17px; height: 17px; border-radius: 50%; background: var(--paper-2); border: 2px solid var(--rule); display: grid; place-items: center; color: #fff; }
  .tl li.done .dot { background: var(--moss); border-color: var(--moss); }
  .when { margin: 0 0 .3rem; font-size: .76rem; letter-spacing: .08em; color: var(--bark); text-transform: uppercase; display: flex; gap: .8rem; align-items: center; flex-wrap: wrap; }
  .tl h3 { margin-bottom: .2em; } .tl p:last-child { margin: 0; color: var(--ink-soft); }
</style>
