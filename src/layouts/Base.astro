---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Search from '../components/Search.astro';
import { url } from '../data/site.js';
import { content, getLang, langs, switchPath } from '../i18n/index.js';

const props = Astro.props;
const lang = props.lang ?? getLang(Astro);
const c = content(lang);
const { site, ui } = c;
const { title, description = site.description, image = '/img/og.png', noindex = false, alternates = true } = props;
const full = title === site.name ? `${site.name}: ${site.tagline}` : `${title} · ${site.name}`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const alt = alternates ? langs.map((l) => ({ l, href: new URL(switchPath(Astro.url.pathname, l), Astro.site ?? Astro.url).href })) : [];
const og = Astro.site ? new URL(url(image), Astro.site).href : url(image);
---
<!doctype html>
<html lang={c.d.htmlLang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#181b29" />
    <meta name="color-scheme" content="light dark" />
    {canonical && <link rel="canonical" href={canonical} />}
    {alt.map((a) => <link rel="alternate" hreflang={a.l} href={a.href} />)}
    {alt.length > 0 && <link rel="alternate" hreflang="x-default" href={new URL(url('/'), Astro.site ?? Astro.url).href} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={c.d.ogLocale} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try { if (localStorage.getItem('lelek-banner') === 'knifes-1') d.classList.add('no-banner'); } catch (e) {}
        var t = null;
        try { t = localStorage.getItem('lelek-theme'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        d.setAttribute('data-theme', t);
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{ui.skip}</a>
    <Header langHome={!alternates} />
    <main id="main" data-pagefind-body={noindex ? undefined : true} data-pagefind-meta={`page:${title}`}>
      <slot />
    </main>
    <Footer />
    <Search />
    <script>
      // theme toggle (icon and label show the mode you will switch to)
      const tbtn = document.getElementById('theme-toggle');
      const root = document.documentElement;
      const meta = document.querySelector('meta[name=theme-color]');
      const paint = () => {
        const dark = root.getAttribute('data-theme') === 'dark';
        const ds = tbtn?.dataset ?? {};
        tbtn?.setAttribute('aria-label', dark ? ds.toLight! : ds.toDark!);
        tbtn?.setAttribute('title', dark ? ds.lightTitle! : ds.darkTitle!);
        meta?.setAttribute('content', dark ? '#0d0f18' : '#f4eee1');
      };
      paint();
      tbtn?.addEventListener('click', () => {
        const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-theme', next);
        try { localStorage.setItem('lelek-theme', next); } catch {}
        paint();
      });
      matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
        let saved = null;
        try { saved = localStorage.getItem('lelek-theme'); } catch {}
        if (saved !== 'light' && saved !== 'dark') { root.setAttribute('data-theme', e.matches ? 'dark' : 'light'); paint(); }
      });
      // language switch: remember the choice (the root page honours it) and keep the #section you are on
      document.querySelectorAll<HTMLAnchorElement>('[data-lang-switch]').forEach((a) => a.addEventListener('click', () => {
        try { localStorage.setItem('lelek-lang', a.dataset.langSwitch!); } catch {}
        a.href = a.href.split('#')[0] + location.hash;
      }));
      // top banner dismissal (remembered per banner id)
      document.getElementById('banner-close')?.addEventListener('click', () => {
        document.documentElement.classList.add('no-banner');
        try { localStorage.setItem('lelek-banner', 'knifes-1'); } catch {}
      });
      // mobile menu
      const btn = document.querySelector('.menu-btn') as HTMLButtonElement | null;
      const nav = document.getElementById('primary-nav');
      const setMenu = (open: boolean) => { btn?.setAttribute('aria-expanded', String(open)); nav?.classList.toggle('open', open); };
      btn?.addEventListener('click', () => setMenu(btn.getAttribute('aria-expanded') !== 'true'));
      nav?.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) setMenu(false); });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setMenu(false); });
      // reveal on scroll
      const els = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });
        els.forEach((el) => io.observe(el));
      } else els.forEach((el) => el.classList.add('in'));
    </script>
  </body>
</html>
